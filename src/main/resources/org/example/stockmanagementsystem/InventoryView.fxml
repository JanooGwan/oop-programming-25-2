<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.InventoryController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <HBox spacing="10">
            <children>
                <Button mnemonicParsing="false" onAction="#handleAddStock" text="Add Stock" />
                <Button mnemonicParsing="false" onAction="#handleAuditExpiry" text="Audit Expiry" />
                <Button mnemonicParsing="false" onAction="#handleCheckLowStock" text="Check Low Stock" />
                <Button mnemonicParsing="false" onAction="#handleRefresh" text="Refresh" />
            </children>
        </HBox>
        <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Name" />
                <TableColumn fx:id="quantityColumn" prefWidth="100.0" text="Quantity" />
                <TableColumn fx:id="unitPriceColumn" prefWidth="100.0" text="Unit Price" />
                <TableColumn fx:id="expiryDateColumn" prefWidth="150.0" text="Expiry Date" />
            </columns>
        </TableView>
    </children>
</VBox>
