<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.OrderController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <HBox spacing="10">
            <children>
                <TextField fx:id="searchField" promptText="Search by Order ID, Stock ID, Status" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleSearch" text="Search" />
                <Button onAction="#handleRefresh" text="Refresh" />
            </children>
        </HBox>
        <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="orderIdColumn" prefWidth="75.0" text="Order ID" />
                <TableColumn fx:id="stockIdColumn" prefWidth="75.0" text="Stock ID" />
                <TableColumn fx:id="quantityColumn" prefWidth="75.0" text="Quantity" />
                <TableColumn fx:id="orderDateColumn" prefWidth="120.0" text="Order Date" />
                <TableColumn fx:id="deliveryDateColumn" prefWidth="120.0" text="Delivery Date" />
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button onAction="#handlePrepare" text="Prepare Delivery" />
                <Button onAction="#handleDeliver" text="Start Delivery" />
                <Button onAction="#handleComplete" text="Complete Order" />
                <Button onAction="#handleCancel" text="Cancel Order" />
            </children>
        </HBox>
    </children>
</VBox>
